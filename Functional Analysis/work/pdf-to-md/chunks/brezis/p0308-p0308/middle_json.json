            0.326
          ],
          "content": [
            {
              "type": "text",
              "content": "Example 2 (inhomogeneous Dirichlet condition). Let "
            },
            {
              "type": "equation_inline",
              "content": "\\Omega \\subset \\mathbb { R } ^ { N }"
            },
            {
              "type": "text",
              "content": " be a bounded open set. We look for a function "
            },
            {
              "type": "equation_inline",
              "content": "u : \\overline { { \\Omega } } \\to \\mathbb { R }"
            },
            {
              "type": "text",
              "content": " satisfying"
