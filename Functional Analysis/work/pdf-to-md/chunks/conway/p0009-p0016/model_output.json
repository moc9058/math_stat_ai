        ],
        "content": [
          {
            "type": "text",
            "content": "Here, for α in "
          },
          {
            "type": "equation_inline",
            "content": "\\mathbf { F } , { \\bar { \\alpha } } = \\alpha { \\mathrm { ~ i f ~ } } \\mathbf { F } = \\mathbf { R }"
          },
          {
            "type": "text",
            "content": " and "
