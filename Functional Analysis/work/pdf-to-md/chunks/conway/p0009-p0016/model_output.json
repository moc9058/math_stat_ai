        "content": [
          {
            "type": "text",
            "content": "(c) "
          },
          {
            "type": "equation_inline",
            "content": "u ( x , x ) \\geqslant 0 ,"
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.127,
          0.836,
          0.314,
          0.855
        ],
        "lines": [
