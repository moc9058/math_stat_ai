          },
          {
            "type": "equation_inline",
            "content": "\\alpha \\geqslant 0"
          },
          {
            "type": "text",
            "content": " means that "
          },
          {
            "type": "equation_inline",
            "content": "\\alpha { \\in } \\mathbb { R }"
