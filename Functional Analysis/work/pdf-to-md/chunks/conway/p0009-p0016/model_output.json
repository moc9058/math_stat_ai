          {
            "type": "text",
            "content": " is the complex conjugate of "
          },
          {
            "type": "equation_inline",
            "content": "\\alpha"
          },
          {
            "type": "text",
            "content": " if "
          },
          {
            "type": "equation_inline",
            "content": "\\mathbf { F } = \\mathbf { C } . \\mathbf { I f }   \\alpha   \\in   \\mathbf { C } ,"
          },
          {
            "type": "text",
