        "content": [
          {
            "type": "text",
            "content": "(b) "
          },
          {
            "type": "equation_inline",
            "content": "u ( x , \\alpha y + \\beta z ) = \\bar { \\alpha } u ( x , y ) + \\bar { \\beta } u ( x , z ) ,"
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.129,
