        "content": [
          {
            "type": "text",
            "content": "(d) "
          },
          {
            "type": "equation_inline",
            "content": "u ( x , y ) = u ( y , x ) ."
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.125,
          0.863,
