              0.799
            ]
          }
        ],
        "content": [
          {
            "type": "text",
            "content": "(a) "
          },
          {
            "type": "equation_inline",
            "content": "u ( \\alpha x + \\beta y , z ) = \\alpha u ( x , z ) + \\beta u ( y , z ) ,"
          }
        ]
      },
      {
        "type": "text",
