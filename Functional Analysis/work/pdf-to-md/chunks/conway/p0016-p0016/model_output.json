        ],
        "content": [
          {
            "type": "text",
            "content": "1.1. Definition. If "
          },
          {
            "type": "equation_inline",
            "content": "\\mathcal { X }"
          },
          {
            "type": "text",
            "content": " is a vector space over "
          },
          {
            "type": "equation_inline",
            "content": "\\mathbb { F } ,"
          },
          {
            "type": "text",
            "content": " a semi-inner product on "
          },
          {
            "type": "equation_inline",
            "content": "\\mathcal { X }"
          },
          {
            "type": "text",
            "content": " is a function u: "
          },
          {
            "type": "equation_inline",
            "content": "\\mathcal { X } \\times \\mathcal { X }   \\rightarrow   \\mathbb { F }"
          },
          {
            "type": "text",
            "content": " such that for all "
          },
          {
            "type": "equation_inline",
            "content": "\\alpha , \\beta"
          },
          {
            "type": "text",
            "content": " in "
          },
          {
            "type": "equation_inline",
            "content": "\\mathbb { F } ,"
          },
          {
            "type": "text",
            "content": " and "
          },
          {
            "type": "equation_inline",
            "content": "x , y , z"
          },
          {
            "type": "text",
            "content": " in "
          },
          {
            "type": "equation_inline",
            "content": "\\mathcal { X }"
          },
          {
            "type": "text",
            "content": " , the following are satisfied:"
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
