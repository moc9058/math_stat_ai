            0.351,
            0.119
          ],
          "content": [
            {
              "type": "text",
              "content": "PROOF. If "
            },
            {
              "type": "equation_inline",
              "content": "f _ { 1 } \\bot f _ { 2 }"
            },
            {
              "type": "text",
              "content": " , then"
            }
          ]
        },
        {
          "type": "equation",
          "index": 3,
          "bbox": [
            0.182,
            0.125,
            0.813,
            0.148
          ],
          "image_path": "images/page_22_equation_3.jpg",
          "content": "\\| f _ { 1 } + f _ { 2 } \\| ^ { 2 } = \\langle f _ { 1 } + f _ { 2 } , f _ { 1 } + f _ { 2 } \\rangle = \\| f _ { 1 } \\| ^ { 2 } + 2 \\operatorname { R e } \\langle f _ { 1 } , f _ { 2 } \\rangle + \\| f _ { 2 } \\| ^ { 2 }"
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.125,
            0.154,
            0.87,
            0.194
          ],
          "content": [
            {
              "type": "text",
              "content": "by the polar identity. Since "
            },
            {
              "type": "equation_inline",
              "content": "f _ { 1 } \\bot f _ { 2 } ,"
            },
            {
              "type": "text",
              "content": " this implies the result for "
            },
            {
              "type": "equation_inline",
              "content": "n   =   2 ."
            },
            {
              "type": "text",
              "content": " The remainder of the proof proceeds by induction and is left to the reader. ■"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.125,
            0.205,
            0.871,
            0.264
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that "
            },
            {
              "type": "equation_inline",
              "content": "{ \\mathrm { i f } } f \\bot g ,"
            },
            {
              "type": "text",
              "content": " thenf "
            },
            {
              "type": "equation_inline",
              "content": "丄  -g,"
            },
            {
              "type": "text",
              "content": " so "
            },
            {
              "type": "equation_inline",
              "content": "\\| f - g \\| ^ { 2 } = \\| f \\| ^ { 2 } + \\| g \\| ^ { 2 }"
            },
            {
              "type": "text",
              "content": " . The next result is an easy consequence of the Pythagorean Theorem if f and g are orthogonal, but this assumption is not needed for its conclusion."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.126,
            0.279,
            0.812,
            0.299
          ],
          "content": [
            {
              "type": "text",
              "content": "2.3. Parallelogram Law. If "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { H }"
            },
            {
              "type": "text",
              "content": " is a Hilbert space and f and "
            },
            {
              "type": "equation_inline",
              "content": "g \\in \\mathcal { H }"
            },
            {
              "type": "text",
              "content": " , then"
            }
          ]
        },
        {
          "type": "equation",
          "index": 7,
          "bbox": [
            0.299,
            0.305,
            0.697,
            0.327
          ],
          "image_path": "images/page_22_equation_7.jpg",
          "content": "\\|   f + g   \\| ^ { 2 } + \\|   f - g   \\| ^ { 2 } = 2 ( \\|   f   \\| ^ { 2 } + \\|   g   \\| ^ { 2 } ) ."
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.127,
            0.334,
            0.68,
            0.354
          ],
          "content": [
            {
              "type": "text",
              "content": "PROOF. For any f and "
            },
            {
              "type": "equation_inline",
              "content": "g"
            },
            {
              "type": "text",
              "content": " in "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { H }"
            },
            {
              "type": "text",
              "content": " the polar identity implies"
            }
          ]
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.302,
            0.36,
            0.696,
            0.405
          ],
          "image_path": "images/page_22_equation_9.jpg",
          "content": "\\begin{array} { r } { \\| f + g \\| ^ { 2 } = \\| f \\| ^ { 2 } + 2   \\mathrm { R e }   \\langle f , g \\rangle + \\| g \\| ^ { 2 } , } \\\\ { \\| f - g \\| ^ { 2 } = \\| f \\| ^ { 2 } - 2   \\mathrm { R e }   \\langle f , g \\rangle + \\| g \\| ^ { 2 } . } \\end{array}"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.126,
            0.406,
            0.232,
            0.425
          ],
          "content": [
            {
              "type": "text",
              "content": "Now add."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.125,
            0.437,
            0.871,
            0.476
          ],
          "content": [
            {
              "type": "text",
              "content": "The next property of a Hilbert space is truly pivotal. But first we need a geometric concept valid for any vector space over "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { E }"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.125,
            0.487,
            0.87,
            0.526
          ],
          "content": [
            {
              "type": "text",
              "content": "2.4. Definition. If ¿ is any vector space over F and "
            },
            {
              "type": "equation_inline",
              "content": "A \\subseteq { \\mathcal { X } }"
            },
            {
              "type": "text",
              "content": " , then A is a convex set if for any x and y in A and "
            },
            {
              "type": "equation_inline",
              "content": "0 \\leqslant t \\leqslant 1,   tx + (1 - t)y \\in A"
            }
          ]
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.124,
            0.536,
            0.871,
            0.59
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that "
            },
            {
              "type": "equation_inline",
              "content": "\\left\\{ t x + ( 1 - t ) y : 0 \\leqslant t \\leqslant 1 \\right\\}"
            },
            {
              "type": "text",
              "content": " is the straight-line segment joining x and y. So a convex set is a set A such that if x and "
            },
            {
              "type": "equation_inline",
              "content": "y \\in A"
            },
            {
              "type": "text",
              "content": " , the entire line segment joining x and y is contained in A."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.125,
            0.59,
            0.871,
            0.665
          ],
          "content": [
            {
              "type": "text",
              "content": "If X is a vector space, then any linear subspace in "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { X }"
            },
            {
              "type": "text",
              "content": " is a convex set. A singleton set is convex. The intersection of any collection of convex sets is convex. If "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { H }"
            },
            {
              "type": "text",
              "content": " is a Hilbert space, then every open ball "
            },
            {
              "type": "equation_inline",
              "content": "B(f;r)=\\{g\\in\\mathcal{H}\\}"
            },
            {
              "type": "text",
              "content": "二 "
            },
            {
              "type": "equation_inline",
              "content": "\\left\\| f - g \\right\\| < r \\big \\}"
            },
            {
              "type": "text",
              "content": " is convex, as is every closed ball."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.124,
            0.675,
            0.87,
            0.714
          ],
          "content": [
            {
              "type": "text",
              "content": "2.5. Theorem. If H is a Hilbert space, K is a closed convex nonempty subset of "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { H }"
            },
            {
              "type": "text",
              "content": " , and "
            },
            {
              "type": "equation_inline",
              "content": "h \\in \\mathcal { H }"
            },
            {
              "type": "text",
              "content": " , then there is a unique point "
            },
            {
              "type": "equation_inline",
              "content": "k _ { 0 }"
            },
            {
              "type": "text",
              "content": " in K such that"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.285,
            0.721,
            0.711,
            0.741
          ],
          "image_path": "images/page_22_equation_16.jpg",
          "content": "\\| \\boldsymbol{h} - \\boldsymbol{k}_0 \\| = \\mathrm{dist}(\\boldsymbol{h}, \\boldsymbol{K}) \\equiv \\inf \\{ \\| \\boldsymbol{h} - \\boldsymbol{k} \\| : \\boldsymbol{k} \\in \\boldsymbol{K} \\}."
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.125,
            0.748,
            0.871,
            0.804
          ],
          "content": [
            {
              "type": "text",
              "content": "PROOF. By considering "
            },
            {
              "type": "equation_inline",
              "content": "K - h \\equiv \\{ k - h { \\mathrm { : ~ } } k { \\in } K \\}"
            },
            {
              "type": "text",
              "content": " instead of K, it suffices to assume that "
            },
            {
              "type": "equation_inline",
              "content": "h = 0.   (  Verify ! )"
            },
            {
              "type": "text",
              "content": " So we want to show that there is a unique vector "
            },
            {
              "type": "equation_inline",
              "content": "k _ { 0 }"
            },
            {
              "type": "text",
              "content": " in K such that"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.325,
            0.807,
            0.67,
            0.827
          ],
          "image_path": "images/page_22_equation_18.jpg",
          "content": "\\| \\boldsymbol { k } _ { 0 } \\| = \\mathrm { d i s t } ( 0 , \\boldsymbol { K } ) \\equiv \\inf \\{ \\| \\boldsymbol { k } \\| : \\boldsymbol { k } \\in \\boldsymbol { K } \\}."
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.126,
            0.834,
            0.87,
            0.873
          ],
          "content": [
            {
              "type": "text",
              "content": "Let "
            },
            {
              "type": "equation_inline",
              "content": "d = \\mathrm{dist}(0, K)"
            },
            {
              "type": "text",
              "content": " . By definition, there is a sequence "
            },
            {
              "type": "equation_inline",
              "content": "\\{ k _ { n } \\}"
            },
            {
              "type": "text",
              "content": " in K such that一 "
            },
            {
              "type": "equation_inline",
              "content": "k _ { n } \\rVert \\to d ."
            },
            {
              "type": "text",
              "content": " Now the Parallelogram Law implies that"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.278,
            0.877,
            0.716,
            0.922
          ],
          "image_path": "images/page_22_equation_20.jpg",
          "content": "\\left\\| \\frac{k_n - k_m}{2} \\right\\|^2 = \\frac{1}{2} \\left( \\left\\| k_n \\right\\|^2 + \\left\\| k_m \\right\\|^2 \\right) - \\left\\| \\frac{k_n + k_m}{2} \\right\\|^2."
        }
      ]
    },
    {
      "page_idx": 23,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.128,
            0.056,
            0.293,
