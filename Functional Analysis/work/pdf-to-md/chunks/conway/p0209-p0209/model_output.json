          }
        ],
        "content": [
          {
            "type": "text",
            "content": "5. Show that for "
          },
          {
            "type": "equation_inline",
            "content": "n \\geqslant 1,   M_n(\\mathbb{C})"
          },
          {
            "type": "text",
            "content": " has no nontrivial ideals. How about "
          },
          {
            "type": "equation_inline",
            "content": "M _ { n } ( \\mathbb { R } ) ?"
          }
        ]
      },
