              "type": "text",
              "content": "§1. Elementary Properties and Examples"
            }
          ]
        },
        {
          "type": "page_number",
          "index": 1,
          "bbox": [
            0.835,
            0.056,
            0.871,
            0.071
          ],
          "content": [
            {
              "type": "text",
              "content": "235"
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.127,
            0.1,
            0.871,
            0.138
          ],
          "content": [
            {
              "type": "text",
              "content": "such that "
            },
            {
              "type": "equation_inline",
              "content": "\\rho _ { 1 } ( 1 ) = 1 ( 1 . 9 )"
            },
            {
              "type": "text",
              "content": " . Thus it suffices to prove the proposition under the additional assumption that "
            },
            {
              "type": "equation_inline",
              "content": "\\varkappa"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { B }"
            },
            {
              "type": "text",
              "content": " have identities and "
            },
            {
              "type": "equation_inline",
              "content": "\\rho ( 1 )   = 1"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.127,
            0.138,
            0.87,
            0.194
          ],
          "content": [
            {
              "type": "equation_inline",
              "content": "\\operatorname { I f } x   \\in   { \\mathcal { A } } ."
            },
            {
              "type": "text",
              "content": " , then it follows that "
            },
            {
              "type": "equation_inline",
              "content": "\\sigma ( \\rho ( x ) ) \\subseteq \\sigma ( x )   { \\mathrm { ( V e r i f y ! ) } }"
            },
            {
              "type": "text",
              "content": " and hence "
            },
            {
              "type": "equation_inline",
              "content": "r(\\rho(x)) \\leqslant r(x)"
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf { S o } ,"
            },
            {
              "type": "text",
              "content": " , using part (e) and the fact that "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { * } a"
            },
            {
              "type": "text",
              "content": " is hermitian, "
            },
            {
              "type": "equation_inline",
              "content": "\\| \\rho ( a ) \\| ^ { 2 } = \\| \\rho ( a ^ { * } a ) \\| ="
            },
            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "r(\\rho(a^{*}a)) \\leqslant r(a^{*}a) = \\|a^{*}a\\| = \\|a\\|^{2}"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.127,
            0.211,
            0.87,
            0.248
          ],
          "content": [
            {
              "type": "text",
              "content": "1.12. Proposition. If A is a C*-algebra and h: "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { A } \\to \\mathbb { C }"
            },
            {
              "type": "text",
              "content": " is a non-zero homomorphism, then:"
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.128,
            0.257,
            0.412,
            0.276
          ],
          "content": [
            {
              "type": "text",
              "content": "(a) "
            },
            {
              "type": "equation_inline",
              "content": "h ( a )   \\in   \\mathbb { R }"
            },
            {
              "type": "text",
              "content": " whenever "
            },
            {
              "type": "equation_inline",
              "content": "a = a ^ { * }"
            },
            {
              "type": "text",
              "content": " •D"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.128,
            0.278,
            0.431,
            0.297
          ],
          "content": [
            {
              "type": "text",
              "content": "(b) "
            },
            {
              "type": "equation_inline",
              "content": "h ( a ^ { * } ) = h ( a )"
            },
            {
              "type": "text",
              "content": " for all a in "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { A } ;"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.129,
            0.298,
            0.419,
            0.316
          ],
          "content": [
            {
              "type": "text",
              "content": "(c) "
            },
            {
              "type": "equation_inline",
              "content": "h ( a ^ { * } a ) \\geqslant 0"
            },
            {
              "type": "text",
              "content": " for all a in "
            },
            {
              "type": "equation_inline",
              "content": "\\alpha ;"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.128,
            0.317,
            0.55,
            0.335
          ],
          "content": [
            {
              "type": "text",
              "content": "(d) if "
            },
            {
              "type": "equation_inline",
              "content": "1 \\in \\mathcal { A }"
            },
            {
              "type": "text",
              "content": " and u is unitary, then "
            },
            {
              "type": "equation_inline",
              "content": "| h ( u ) | = 1"
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.127,
            0.344,
            0.871,
            0.399
          ],
          "content": [
            {
              "type": "text",
              "content": "PRoOF. If  has no identity, extend h to "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { A } _ { 1 }"
            },
            {
              "type": "text",
              "content": " by letting "
            },
            {
              "type": "equation_inline",
              "content": "h ( 1 ) = 1"
            },
            {
              "type": "text",
              "content": " . Thus, we may assume that "
            },
            {
              "type": "equation_inline",
              "content": "\\varkappa"
            },
            {
              "type": "text",
              "content": " has an identity. By Exercise VII.8.1, "
            },
            {
              "type": "equation_inline",
              "content": "\\| h \\| = 1"
            },
            {
              "type": "text",
              "content": " . If "
            },
            {
              "type": "equation_inline",
              "content": "a = a ^ { * }"
            },
            {
              "type": "text",
              "content": " and "
            },
            {
              "type": "equation_inline",
              "content": "t { \\in } \\mathbb { R }"
            }
          ]
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.287,
            0.404,
            0.705,
            0.47
          ],
          "image_path": "images/page_249_equation_10.jpg",
          "content": "\\begin{aligned}\\| h(a + it) \\|^2 & \\leqslant \\|   a + it \\|^2 = \\| (a + it)^* (a + it) \\| \\\\& = \\| (a - it) (a + it) \\| \\\\& = \\|   a^2 + t^2 \\| \\leqslant \\|   a   \\|^2 + t^2.\\end{aligned}"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.126,
            0.478,
            0.532,
            0.498
          ],
          "content": [
            {
              "type": "text",
              "content": "If "
            },
            {
              "type": "equation_inline",
              "content": "h ( a ) = \\alpha + i \\beta , \\alpha , \\beta"
            },
            {
              "type": "text",
              "content": " in R, then this yields"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.346,
            0.505,
            0.651,
            0.572
          ],
          "image_path": "images/page_249_equation_12.jpg",
          "content": "\\begin{aligned}\\| \\boldsymbol{a} \\|^2 + t^2 & \\geqslant | \\boldsymbol{\\alpha} + i (\\beta + t) |^2 \\\\& = \\boldsymbol{\\alpha}^2 + (\\beta + t)^2 \\\\& = \\boldsymbol{\\alpha}^2 + \\beta^2 + 2\\beta t + t^2 ;\\end{aligned}"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.125,
            0.579,
            0.868,
            0.634
          ],
          "content": [
            {
              "type": "text",
              "content": "hence "
            },
            {
              "type": "equation_inline",
              "content": "\\| a \\| ^ { 2 } \\geqslant \\alpha ^ { 2 } + \\beta ^ { 2 } + 2 \\beta t"
            },
            {
              "type": "text",
              "content": " for all t in R. If "
            },
            {
              "type": "equation_inline",
              "content": "\\beta \\neq 0 ."
            },
            {
              "type": "text",
              "content": " then letting "
            },
            {
              "type": "equation_inline",
              "content": "t   \\rightarrow \\pm \\infty"
            },
            {
              "type": "text",
              "content": " depending on the sign of "
            },
            {
              "type": "equation_inline",
              "content": "\\beta ,"
            },
            {
              "type": "text",
              "content": " gives a contradiction. Therefore "
            },
            {
              "type": "equation_inline",
              "content": "\\beta   =   0"
            },
            {
              "type": "text",
              "content": " or "
            },
            {
              "type": "equation_inline",
              "content": "h ( a )   \\in   \\mathbb { R }"
            },
            {
              "type": "text",
              "content": " This proves (a)."
            }
          ]
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.125,
            0.634,
            0.869,
            0.69
          ],
          "content": [
            {
              "type": "text",
              "content": "Let "
            },
            {
              "type": "equation_inline",
              "content": "a = x + i y ,"
            },
            {
              "type": "text",
              "content": " , where x and y are hermitian. Since "
            },
            {
              "type": "equation_inline",
              "content": "h ( x ) , h ( y ) { \\in } \\mathbb { R }"
            },
            {
              "type": "text",
              "content": " by (a) and "
            },
            {
              "type": "equation_inline",
              "content": "a ^ { \\star } = x - i y"
            },
            {
              "type": "text",
              "content": " , (b) follows. Also, "
            },
            {
              "type": "equation_inline",
              "content": "h(a^{*}a)=h(a^{*})h(a)=|h(a)|^{2}\\geqslant0"
            },
            {
              "type": "text",
              "content": " , so (c) holds. Finally, if u is unitary, "
            },
            {
              "type": "equation_inline",
              "content": "| h ( u ) | ^ { 2 } = h ( u ^ { * } ) h ( u ) = h ( u ^ { * } u ) = h ( 1 ) = 1 ."
            }
          ]
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.124,
            0.707,
            0.87,
            0.763
          ],
          "content": [
            {
              "type": "text",
              "content": "Note that part (b) of the preceding proposition implies that any homomorphism h: "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { A } \\to \\mathbb { C }"
            },
            {
              "type": "text",
              "content": " is a *-homomorphism. This, coupled with (VII.8.6), gives the following corollary."
            }
          ]
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.125,
            0.78,
            0.869,
            0.817
          ],
          "content": [
            {
              "type": "text",
              "content": "1.13. Corollary. If A is an abelian "
            },
            {
              "type": "equation_inline",
              "content": "C ^ { * } { \\textbar } { - a l g e b r a }"
            },
            {
              "type": "text",
              "content": " and a is a hermitian element of A, then "
            },
            {
              "type": "equation_inline",
              "content": "\\sigma ( a ) \\subseteq \\mathbb { R }"
            }
          ]
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.125,
            0.835,
            0.871,
            0.871
          ],
          "content": [
            {
              "type": "text",
              "content": "This corollary is short-lived as the conclusion remains valid even if "
            },
            {
              "type": "equation_inline",
              "content": "\\varkappa"
            },
            {
              "type": "text",
              "content": " is not abelian."
            }
          ]
        },
        {
          "type": "text",
          "index": 18,
          "bbox": [
            0.126,
            0.89,
            0.871,
            0.927
          ],
          "content": [
            {
              "type": "text",
              "content": "1.14. Proposition. Let A and B be C*-algebras with a common identity and norm such that "
            },
            {
              "type": "equation_inline",
              "content": "\\mathcal { A } \\subseteq \\mathcal { B }"
            },
            {
              "type": "text",
              "content": " If "
            },
            {
              "type": "equation_inline",
              "content": "a \\in \\mathcal { A } ,"
            },
            {
              "type": "text",
              "content": " then "
            },
            {
              "type": "equation_inline",
              "content": "\\sigma _ { \\mathcal { A } } ( a ) = \\sigma _ { \\mathcal { B } } ( a )"
            }
          ]
        }
      ]
    }
